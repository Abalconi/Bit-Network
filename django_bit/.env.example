# Variables de Entorno para Producción / Staging de BIT (Django + PostgreSQL)

# 1. Seguridad de Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-aleatoria-y-robusta-en-produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tudominio.com,api.tudominio.com,localhost,127.0.0.1

# 2. Base de Datos PostgreSQL
DATABASE_URL=postgresql://bit_user:tu_password_seguro@localhost:5432/bit_db
# O configuracion individual:
# POSTGRES_DB=bit_db
# POSTGRES_USER=bit_user
# POSTGRES_PASSWORD=tu_password_seguro
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# 3. CORS para el frontend (React / Web)
CORS_ALLOWED_ORIGINS=https://tudominio.com,http://localhost:3000

# 4. Flags de Seguridad HTTPS (activar en producción con SSL)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
